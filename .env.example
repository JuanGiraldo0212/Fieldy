# Copy to .env.local and fill. .env.local is gitignored — never commit real values.

# ── Supabase ────────────────────────────────────────────────────────────────
# Public. Safe in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret. Server only, never NEXT_PUBLIC_. Bypasses RLS.
SUPABASE_SECRET_KEY=

# Postgres. Direct connection (port 5432) for drizzle-kit migrations.
# Supabase dashboard → Project Settings → Database → Connection string → URI
DATABASE_URL=

# Pooled connection (port 6543, pgbouncer) for the running app.
DATABASE_POOL_URL=

# ── Mapbox ──────────────────────────────────────────────────────────────────
# Geocoding only, server side: room and centre addresses, and the one-time
# catalog geocode. Maps themselves are OpenStreetMap tiles via Leaflet.
MAPBOX_TOKEN=

# ── Resend ──────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# The relay domain. Outbound and inbound both live here: trip-<token>@$MAIL_DOMAIN
MAIL_DOMAIN=
# Magic links go out on a separate subdomain to keep reputations apart.
AUTH_DOMAIN=

# In development every venue-bound email goes here instead. Never a real venue.
DEV_EMAIL_OVERRIDE=

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
